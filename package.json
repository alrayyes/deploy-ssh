{
	"name": "deploy-ssh",
	"version": "1.3.4",
	"private": true,
	"description": "Alpine image used for deployment",
	"bugs": {
		"url": "https://github.com/alrayyes/deploy-ssh/issues"
	},
	"repository": "https://github.com/alrayyes/deploy-ssh",
	"license": "GPL-3.0-or-later",
	"author": "Ryan Kes <511318+alrayyes@users.noreply.github.com>",
	"scripts": {
		"audit": "bun audit",
		"check:biome-schema": "./scripts/check-biome-schema.sh",
		"format": "prettier --write \"**/*.{md,yml,yaml}\"",
		"format:check": "prettier --check \"**/*.{md,yml,yaml}\"",
		"lint": "biome check",
		"lint:fix": "biome check --write",
		"lint:md": "markdownlint-cli2",
		"lint:mechanics": "./scripts/lint-mechanics.sh",
		"lint:pkg": "sort-package-json --check",
		"lint:pkg:fix": "sort-package-json",
		"lint:prose": "./scripts/lint-prose.sh",
		"prepare": "lefthook install"
	},
	"overrides": {
		"smol-toml": "1.7.1"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.14",
		"@commitlint/cli": "21.2.2",
		"@commitlint/config-conventional": "21.2.2",
		"lefthook": "2.1.14",
		"markdownlint-cli2": "0.23.2",
		"prettier": "3.9.8",
		"sort-package-json": "4.0.0"
	}
}
