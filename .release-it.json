{
	"git": {
		"commitMessage": "chore: release v${version}",
		"requireCommits": true
	},
	"plugins": {
		"@release-it/conventional-changelog": {
			"preset": { "name": "conventionalcommits" },
			"infile": "CHANGELOG.md",
			"header": "# Changelog"
		}
	},
	"github": {
		"release": true
	},
	"hooks": {
		"before:init": "git fetch --prune --prune-tags origin"
	}
}
